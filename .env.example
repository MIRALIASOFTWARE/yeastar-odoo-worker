# Copia este archivo a gateway.env (Docker) o a /etc/yeastar-odoo-gateway.env (systemd).
# IMPORTANTE: no pongas comentarios en la misma línea que un valor.

# --- Obligatorias ---
ODOO_URL=https://TU-INSTANCIA.odoo.com
ODOO_DB=nombre_de_tu_base_de_datos
ODOO_API_KEY=pon-aqui-la-api-key-nueva
PBX_WEBHOOK_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# --- Opcionales (entre paréntesis, el valor por defecto) ---
# Usuario dueño de la API key (6)
ODOO_UID=6
# Zona horaria del negocio (America/Havana)
BUSINESS_TZ=America/Havana
# PIN para /citas; si no lo defines, /citas queda desactivada
#OWNER_PIN=123456
# Contacto cuya agenda se revisa (3)
OWNER_PARTNER_ID=3
# Responsable de las citas (2)
CAL_USER_ID=2
# Asistentes de las citas (3,13)
CAL_PARTNER_IDS=3,13
# Equipo, responsable y etapa inicial de los tickets (1, 2, 1)
HELPDESK_TEAM_ID=1
HELPDESK_USER_ID=2
HELPDESK_STAGE_ID=1
# Nivel de log: info normalmente; debug solo para depurar
RUST_LOG=info
# Solo systemd: en Docker lo fija docker-compose.yml
#BIND_ADDR=127.0.0.1:8080
